# ==========================================
# LeadPilot AI - Environment Configuration
# ==========================================

# Google Gemini API Key (Get free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (Optional: Fallback to built-in mock database if omitted)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leadpilot
DATABASE_NAME=leadpilot

# Environment Mode (development | production)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Frontend Environment (used in frontend/.env)
VITE_API_URL=http://localhost:8000
